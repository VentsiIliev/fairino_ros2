# ZeroErr RT / CPU / IRQ policy.
#
# This file is the single source of truth for process pinning and IRQ
# affinity. launch_zeroerr.sh, full_stack.launch.py, and EtherCatStart.sh consume
# these exported values.

ZEROERR_CPU_COUNT="${ZEROERR_CPU_COUNT:-$(nproc --all 2>/dev/null || echo 4)}"
ZEROERR_ALL_CORES="${ZEROERR_ALL_CORES:-0-$((ZEROERR_CPU_COUNT - 1))}"

zeroerr_policy_kernel_isolated_cores() {
  if [ -r /sys/devices/system/cpu/isolated ]; then
    local isolated
    isolated="$(cat /sys/devices/system/cpu/isolated 2>/dev/null || true)"
    if [ -n "$isolated" ]; then
      printf '%s\n' "$isolated"
      return 0
    fi
  fi
  tr ' ' '\n' < /proc/cmdline 2>/dev/null \
    | awk -F= '/^(isolcpus|nohz_full)=/ {print $2; exit}' \
    | sed 's/managed_irq,//g; s/domain,//g; s/nohz,//g' || true
}

zeroerr_policy_cpu_list_last() {
  python3 - "$1" <<'PY'
import sys
cpus = []
for part in sys.argv[1].split(","):
    part = part.strip()
    if not part:
        continue
    if "-" in part:
        start, end = [int(value) for value in part.split("-", 1)]
        cpus.extend(range(start, end + 1))
    else:
        cpus.append(int(part))
print(max(cpus))
PY
}

zeroerr_policy_cpu_list_except() {
  python3 - "$1" "$2" <<'PY'
import sys

def expand(value):
    cpus = set()
    for part in str(value).split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            start, end = [int(item) for item in part.split("-", 1)]
            cpus.update(range(start, end + 1))
        else:
            cpus.add(int(part))
    return cpus

def compact(cpus):
    if not cpus:
        return ""
    values = sorted(cpus)
    ranges = []
    start = previous = values[0]
    for value in values[1:]:
        if value == previous + 1:
            previous = value
            continue
        ranges.append((start, previous))
        start = previous = value
    ranges.append((start, previous))
    return ",".join(str(a) if a == b else f"{a}-{b}" for a, b in ranges)

print(compact(expand(sys.argv[1]) - expand(sys.argv[2])))
PY
}

ZEROERR_KERNEL_ISOLATED_CORES="${ZEROERR_KERNEL_ISOLATED_CORES:-$(zeroerr_policy_kernel_isolated_cores)}"

if [ -n "$ZEROERR_KERNEL_ISOLATED_CORES" ]; then
  ZEROERR_POLICY_DEFAULT_CONTROL_CORES="$(zeroerr_policy_cpu_list_last "$ZEROERR_KERNEL_ISOLATED_CORES")"
  ZEROERR_POLICY_DEFAULT_AUX_CORES="$(zeroerr_policy_cpu_list_except "$ZEROERR_KERNEL_ISOLATED_CORES" "$ZEROERR_POLICY_DEFAULT_CONTROL_CORES")"
  ZEROERR_POLICY_DEFAULT_ISOLATED_CORES="$ZEROERR_KERNEL_ISOLATED_CORES"
  ZEROERR_POLICY_DEFAULT_NON_RT_CORES="$(zeroerr_policy_cpu_list_except "$ZEROERR_ALL_CORES" "$ZEROERR_KERNEL_ISOLATED_CORES")"
  ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES="0"
  if [ "$ZEROERR_CPU_COUNT" -ge 8 ]; then
    ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES="0,1"
  fi
  ZEROERR_POLICY_DEFAULT_PLANNER_CORES="$(zeroerr_policy_cpu_list_except "$ZEROERR_POLICY_DEFAULT_NON_RT_CORES" "$ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES")"
elif [ "$ZEROERR_CPU_COUNT" -ge 8 ]; then
  ZEROERR_POLICY_DEFAULT_CONTROL_CORES="$((ZEROERR_CPU_COUNT - 1))"
  ZEROERR_POLICY_DEFAULT_AUX_CORES=""
  ZEROERR_POLICY_DEFAULT_ISOLATED_CORES="$ZEROERR_POLICY_DEFAULT_CONTROL_CORES"
  ZEROERR_POLICY_DEFAULT_NON_RT_CORES="0-$((ZEROERR_CPU_COUNT - 2))"
  ZEROERR_POLICY_DEFAULT_PLANNER_CORES="2-$((ZEROERR_CPU_COUNT - 2))"
  ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES="0,1"
else
  ZEROERR_POLICY_DEFAULT_CONTROL_CORES="3"
  ZEROERR_POLICY_DEFAULT_AUX_CORES=""
  ZEROERR_POLICY_DEFAULT_ISOLATED_CORES="3"
  ZEROERR_POLICY_DEFAULT_NON_RT_CORES="0,1,2"
  ZEROERR_POLICY_DEFAULT_PLANNER_CORES="1,2"
  ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES="0"
fi

# Clear names used by the policy.
ZEROERR_RT_CONTROL_CORES="${ZEROERR_RT_CONTROL_CORES:-${ZEROERR_CONTROL_CORES:-$ZEROERR_POLICY_DEFAULT_CONTROL_CORES}}"
ZEROERR_RT_AUX_CORES="${ZEROERR_RT_AUX_CORES:-$ZEROERR_POLICY_DEFAULT_AUX_CORES}"
ZEROERR_RT_ISOLATED_CORES="${ZEROERR_RT_ISOLATED_CORES:-${ZEROERR_ISOLATED_CORES:-$ZEROERR_POLICY_DEFAULT_ISOLATED_CORES}}"

ZEROERR_NON_RT_CORES="${ZEROERR_NON_RT_CORES:-$ZEROERR_POLICY_DEFAULT_NON_RT_CORES}"
ZEROERR_PLANNER_CORES="${ZEROERR_PLANNER_CORES:-$ZEROERR_POLICY_DEFAULT_PLANNER_CORES}"
ZEROERR_LOW_PRIORITY_CORES="${ZEROERR_LOW_PRIORITY_CORES:-$ZEROERR_POLICY_DEFAULT_LOW_PRIORITY_CORES}"

ZEROERR_ETHERCAT_IFACE="${ZEROERR_ETHERCAT_IFACE:-${ZEROERR_NIC:-enp3s0}}"
ZEROERR_ETHERCAT_CORES="${ZEROERR_ETHERCAT_CORES:-${ZEROERR_RT_AUX_CORES:-$ZEROERR_RT_CONTROL_CORES}}"
ZEROERR_ETHERCAT_IRQ_CORES="${ZEROERR_ETHERCAT_IRQ_CORES:-${ZEROERR_IRQ_CORES:-$ZEROERR_ETHERCAT_CORES}}"
ZEROERR_MOVE_IRQS_AWAY_FROM="${ZEROERR_MOVE_IRQS_AWAY_FROM:-$ZEROERR_RT_ISOLATED_CORES}"
ZEROERR_MOVE_IRQS_TO="${ZEROERR_MOVE_IRQS_TO:-$ZEROERR_NON_RT_CORES}"

# This is a policy value only. The launch file must not wrap the whole
# ros2_control_node process in FIFO 90; controller_manager owns its RT thread.
ZEROERR_CONTROL_FIFO="${ZEROERR_CONTROL_FIFO:-90}"
ZEROERR_CONTROLLER_MANAGER_FIFO="${ZEROERR_CONTROLLER_MANAGER_FIFO:-50}"
ZEROERR_ETHERCAT_FIFO="${ZEROERR_ETHERCAT_FIFO:-90}"

# Conservative Servo defaults on small machines; callers can override either way.
ZEROERR_SERVO_LOW_CPU="${ZEROERR_SERVO_LOW_CPU:-$([ "$ZEROERR_CPU_COUNT" -le 4 ] && echo true || echo false)}"
if [ "$ZEROERR_SERVO_LOW_CPU" = "true" ] || [ "$ZEROERR_SERVO_LOW_CPU" = "1" ]; then
  ZEROERR_SERVO_REALTIME="${ZEROERR_SERVO_REALTIME:-false}"
  ZEROERR_SERVO_PERIOD="${ZEROERR_SERVO_PERIOD:-0.02}"
else
  ZEROERR_SERVO_REALTIME="${ZEROERR_SERVO_REALTIME:-true}"
  ZEROERR_SERVO_PERIOD="${ZEROERR_SERVO_PERIOD:-0.01}"
fi

ZEROERR_PIN_NON_RT_AWAY="${ZEROERR_PIN_NON_RT_AWAY:-1}"
ZEROERR_MOVE_NON_ETHERCAT_IRQS="${ZEROERR_MOVE_NON_ETHERCAT_IRQS:-1}"
ZEROERR_RT_POLICY_STRICT="${ZEROERR_RT_POLICY_STRICT:-1}"

# Backwards-compatible variable names used by existing launch scripts.
ZEROERR_ISOLATED_CORES="${ZEROERR_ISOLATED_CORES:-$ZEROERR_RT_ISOLATED_CORES}"
ZEROERR_CONTROL_CORES="${ZEROERR_CONTROL_CORES:-$ZEROERR_RT_CONTROL_CORES}"
ZEROERR_IRQ_CORES="${ZEROERR_IRQ_CORES:-$ZEROERR_ETHERCAT_IRQ_CORES}"
ZEROERR_NIC="${ZEROERR_NIC:-$ZEROERR_ETHERCAT_IFACE}"

export ZEROERR_CPU_COUNT ZEROERR_ALL_CORES ZEROERR_KERNEL_ISOLATED_CORES
export ZEROERR_RT_POLICY_FILE
export ZEROERR_RT_CONTROL_CORES ZEROERR_RT_AUX_CORES ZEROERR_RT_ISOLATED_CORES
export ZEROERR_NON_RT_CORES ZEROERR_PLANNER_CORES ZEROERR_LOW_PRIORITY_CORES
export ZEROERR_ETHERCAT_IFACE ZEROERR_ETHERCAT_CORES ZEROERR_ETHERCAT_IRQ_CORES
export ZEROERR_MOVE_IRQS_AWAY_FROM ZEROERR_MOVE_IRQS_TO
export ZEROERR_CONTROL_FIFO ZEROERR_CONTROLLER_MANAGER_FIFO ZEROERR_ETHERCAT_FIFO
export ZEROERR_SERVO_LOW_CPU ZEROERR_SERVO_REALTIME ZEROERR_SERVO_PERIOD
export ZEROERR_PIN_NON_RT_AWAY ZEROERR_MOVE_NON_ETHERCAT_IRQS ZEROERR_RT_POLICY_STRICT
export ZEROERR_ISOLATED_CORES ZEROERR_CONTROL_CORES ZEROERR_IRQ_CORES ZEROERR_NIC
