<?xml version="1.0"?>
<robot name="eRobo3">

  <!-- ================= BASE LINK ================= -->
  <link name="base_link">
    <!-- Empty root link -->
  </link>

  <link name="base_link_inertial">
    <collision name="base_link_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/base_link.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00083" ixy="0.00001" ixz="0.00001" iyy="0.00085" iyz="0.00003" izz="0.00110"/>
      <origin rpy="0 0 0" xyz="0.00095 -0.00172 0.03600"/>
      <mass value="0.47602"/>
    </inertial>
    <visual name="base_link_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_grey"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/base_link.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="base_link_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertial"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= JOINTS & LINKS ================= -->
  <joint name="Joint_1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="Link_1"/>
    <axis xyz="0 0 1"/>
    <limit effort="2.0" lower="-6.28318" upper="6.28318" velocity="6.28" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-6.28" soft_upper_limit="6.28" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_1">
    <collision name="Link_1_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_1.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00054" ixy="0" ixz="0" iyy="0.00052" iyz="0" izz="0.00054"/>
      <origin rpy="0 0 0" xyz="0.00000 0.00308 0.13617"/>
      <mass value="0.50622"/>
    </inertial>
    <visual name="Link_1_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_1.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="Joint_2" type="revolute">
    <origin rpy="0 0 0" xyz="0.00000 0.05300 0.14050"/>
    <parent link="Link_1"/>
    <child link="Link_2"/>
    <axis xyz="0 -1 0"/>
    <limit effort="2.0" lower="-3.14159" upper="3.14159" velocity="6.28" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_2">
    <collision name="Link_2_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_2.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00157" ixy="0" ixz="0" iyy="0.00156" iyz="0" izz="0.00119"/>
      <origin rpy="0 0 0" xyz="0.00000 0.04217 0.11937"/>
      <mass value="1.16203"/>
    </inertial>
    <visual name="Link_2_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_2.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="Joint_3" type="revolute">
    <origin rpy="0 0 0" xyz="0.00000 0.00050 0.24350"/>
    <parent link="Link_2"/>
    <child link="Link_3"/>
    <axis xyz="0 -1 0"/>
    <limit effort="2.0" lower="-3.14159" upper="3.14159" velocity="6.28" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_3">
    <collision name="Link_3_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_3.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00081" ixy="0" ixz="0" iyy="0.00091" iyz="-0.00001" izz="0.00062"/>
      <origin rpy="0 0 0" xyz="0.00000 -0.05451 0.09532"/>
      <mass value="0.77552"/>
    </inertial>
    <visual name="Link_3_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_3.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="Joint_4" type="revolute">
    <origin rpy="0 0 0" xyz="0.00000 -0.01400 0.21100"/>
    <parent link="Link_3"/>
    <child link="Link_4"/>
    <axis xyz="0 -1 0"/>
    <limit effort="1.5" lower="-4.88692" upper="3.14159" velocity="6.28" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-4.88" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_4">
    <collision name="Link_4_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_4.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00024" iyz="0" izz="0.00026"/>
      <origin rpy="0 0 0" xyz="0.00001 0.04110 0.00150"/>
      <mass value="0.31668"/>
    </inertial>
    <visual name="Link_4_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_4.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="Joint_5" type="revolute">
    <origin rpy="0 0 0" xyz="0.00000 0.04700 0.03900"/>
    <parent link="Link_4"/>
    <child link="Link_5"/>
    <axis xyz="0 0 1"/>
    <limit effort="1.5" lower="-3.14159" upper="3.14159" velocity="6.28" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_5">
    <collision name="Link_5_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_5.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.00026" iyz="0" izz="0.00024"/>
      <origin rpy="0 0 0" xyz="-0.00001 0.00150 0.04110"/>
      <mass value="0.31668"/>
    </inertial>
    <visual name="Link_5_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_5.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <joint name="Joint_6" type="revolute">
    <origin rpy="0 0 0" xyz="0.00000 0.06080 0.04700"/>
    <parent link="Link_5"/>
    <child link="Link_6"/>
    <axis xyz="0 1 0"/>
    <limit effort="4.0" lower="-12.5664" upper="12.5664" velocity="12.56" />
    <safety_controller k_position="100.0" k_velocity="100.0" soft_lower_limit="-12.56" soft_upper_limit="12.56" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>

  <link name="Link_6">
    <collision name="Link_6_collision">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_6.stl" scale="1 1 1"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00007" iyz="0" izz="0.00004"/>
      <origin rpy="0 0 0" xyz="0.00000 -0.00578 0.00013"/>
      <mass value="0.10121"/>
    </inertial>
    <visual name="Link_6_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="material_orange"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/welding/Link_6.stl" scale="1 1 1"/>
      </geometry>
    </visual>
  </link>

  <!-- ================= END EFFECTOR ================= -->
  <link name="ee_link"/>

  <joint name="link6_to_ee" type="fixed">
    <parent link="Link_6"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
  </joint>

  <!-- ================= MATERIALS ================= -->
  <material name="material_orange">
    <color rgba="0.8 0.4 0.0 1.0"/>
  </material>

  <material name="material_grey">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

</robot>