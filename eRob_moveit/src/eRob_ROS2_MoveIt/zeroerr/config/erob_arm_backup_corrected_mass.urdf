    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>
  <joint name="Joint_4" type="revolute">
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 -0.01400 0.31100"/>
    <parent link="Link_3"/>
    <child link="Link_4"/>
    <axis xyz="0.00000 -1.00000 0.00000"/>
    <limit effort="1.5" lower="-4.88692" upper="3.14159" velocity="1000.0" acceleration="12.0" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-4.88" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>
  <joint name="Joint_5" type="revolute">
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.04700 0.03900"/>
    <parent link="Link_4"/>
    <child link="Link_5"/>
    <axis xyz="0.00000 0.00000 1.00000"/>
    <limit effort="1.5" lower="-3.14159" upper="3.14159" velocity="1000.0" acceleration="12.0" />
    <safety_controller k_position="100.0" k_velocity="10.0" soft_lower_limit="-3.14" soft_upper_limit="3.14" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>
  <joint name="Joint_6" type="revolute">
    <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.06080 0.04700"/>
    <parent link="Link_5"/>
    <child link="Link_6"/>
    <axis xyz="0.00000 1.00000 0.00000"/>
    <limit effort="4.0" lower="-12.5664" upper="12.5664" velocity="1000.0" acceleration="25.0" />
    <safety_controller k_position="100.0" k_velocity="100.0" soft_lower_limit="-12.56" soft_upper_limit="12.56" />
    <dynamics damping="0.7" friction="0.0"/>
  </joint>



  <link name="Link_1">
    <collision name="Link_1_collision">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/Link_1.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00054" ixy="0.00000" ixz="0.00000" iyy="0.00052" iyz="0.00000" izz="0.00054"/>
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00308 0.13617"/>
      <mass value="0.50622"/>
    </inertial>
    <visual name="Link_1_visual">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <material name="#ffffffff"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/Link_1.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </visual>
  </link>
  <link name="Link_2">
    <collision name="Link_2_collision">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <geometry>
