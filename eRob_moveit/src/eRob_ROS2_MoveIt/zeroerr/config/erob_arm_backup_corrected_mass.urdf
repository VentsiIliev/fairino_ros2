  <link name="Link_6">
    <collision name="Link_6_collision">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/Link_6.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00004" ixy="0.00000" ixz="0.00000" iyy="0.00007" iyz="0.00000" izz="0.00004"/>
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 -0.00578 0.00013"/>
      <mass value="0.10121"/>
    </inertial>
    <visual name="Link_6_visual">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <material name="#ffffffff"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/Link_6.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </visual>
  </link>
  <link name="base_link">
    <!-- empty root link (no inertial element) -->
  </link>

  <!-- child link holding the physical representation and inertial properties -->
  <link name="base_link_inertial">
    <collision name="base_link_collision">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/base_link.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </collision>
    <inertial>
      <inertia ixx="0.00083" ixy="0.00001" ixz="0.00001" iyy="0.00085" iyz="0.00003" izz="0.00110"/>
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00095 -0.00172 0.03600"/>
      <mass value="0.47602"/>
    </inertial>
    <visual name="base_link_visual">
      <origin rpy="0.00000 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
      <material name="base"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/base_link.stl" scale="1.00000 1.00000 1.00000"/>
      </geometry>
    </visual>
  </link>

  <!-- Fixed joint attaching the inertial child to the root -->
  <joint name="base_link_fixed_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_link_inertial"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <material name="#ffffffff">
    <color rgba="0.8000 0.40000 0 1.0000"/>
  </material>
    <material name="base">
    <color rgba="0.40000 0.40000 0.40000 1.0000"/>
  </material>
    <!-- Tool0 frame -->
  <link name="tool0">
    <!-- TEMPORARILY COMMENTED OUT: ToolPointer mesh
    <visual name="ToolPointer_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/ToolPointer.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="tool_material">
        <color rgba="0.7 0.7 0.7 1"/>
      </material>
    </visual>
    <collision name="ToolPointer_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/ToolPointer.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    -->
  </link>

  <joint name="tool0" type="fixed">
    <parent link="Link_6"/>
    <child link="tool0"/>
    <origin xyz="0.0 0.042 -0.030" rpy="-1.5708 0.0 3.14159"/>
  </joint>

  <!-- TCP frame at the actual tool center point (tip of ToolPointer) -->
  <link name="tcp">
    <visual name="TCP_marker">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.008"/>
      </geometry>
      <material name="tool_marker">
        <color rgba="1 0 0 1"/>
      </material>
    </visual>
    <!-- TEMPORARILY COMMENTED OUT: ToolPointer collision
    <collision name="TCP_collision">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://zeroerr/meshes/ToolPointer.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    -->
  </link>

  <joint name="tcp_joint" type="fixed">
    <parent link="tool0"/>
    <child link="tcp"/>
    <origin xyz="0 -0.0305 -0.083" rpy="0 0 0"/>
  </joint>

  <material name="tool_marker">
    <color rgba="1 0 0 1"/>
  </material>

  <!-- TABLE: Fixed collision object representing the work surface -->
  <!-- This allows MoveIt to automatically avoid the table without manual Z limits -->
  <!-- Table top at Z=0.08m (80mm above base) to provide larger safety margin -->
  <link name="table">
    <visual>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.05"/> <!-- 2m x 2m x 5cm table -->
      </geometry>
      <material name="table_material">
        <color rgba="0.6 0.4 0.2 0.8"/> <!-- Brown with some transparency -->
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.055" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.05"/> <!-- 2m x 2m x 5cm table -->
      </geometry>
    </collision>
  </link>

  <joint name="table_joint" type="fixed">
    <parent link="base_link"/>
    <child link="table"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <material name="table_material">
    <color rgba="0.6 0.4 0.2 0.8"/>
  </material>

  <!-- ===== CubeEye 2.0 ToF Camera Mount ===== TEMPORARILY COMMENTED OUT
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.100 0.050 0.040"/>
      </geometry>
      <material name="camera_material">
        <color rgba="0.1 0.5 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.060 0.024 0.024"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.060"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.000010" ixy="0" ixz="0" iyy="0.000020" iyz="0" izz="0.000010"/>
    </inertial>
  </link>

  <link name="camera_optical_frame"/>

  <joint name="camera_joint" type="fixed">
    <parent link="tool0"/>
    <child link="camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-2.78944 0.0 3.14159"/>
  </joint>

  <material name="camera_material">
    <color rgba="0.1 0.5 1.0 1.0"/>
  </material>
  END CAMERA COMMENT OUT -->

  <!-- Ensure joint limits here match those in ros2_control.xacro and SRDF for correct planner behavior -->
</robot>
