<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!--
        Reusable ros2_control joint definition.

        Provides:
            <xacro:erob_control_joint ... />

        In fake mode:
            - position command interface
            - position / velocity / effort state interfaces

        In real mode it additionally provides:
            - reset_fault
            - enable_set
            - disable_set
            - statusword
            - error_code
            - mode_display
            - EtherCAT ec_module
    -->
    <xacro:include
        filename="$(find zeroerr)/config/urdfs/eRob.ros2_control.macros.xacro"
    />

    <!--
        Public macro name intentionally remains the same as the
        existing single-robot implementation.

        eRobo3.urdf.xacro does not need to know whether the active
        implementation represents one robot or two robots.
    -->
    <xacro:macro
        name="eRobo3_ros2_control"
        params="
            name
            initial_positions_file
            use_fake_hardware:=false">

        <!--
            Profile-specific initial positions.

            Expected keys for twin_robots:

                robot1_Joint_1 ... robot1_Joint_6
                robot2_Joint_1 ... robot2_Joint_6
        -->
        <xacro:property
            name="initial_positions"
            value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"
        />

        <!--
            IMPORTANT:

            Both robots belong to ONE ros2_control System.

            Real hardware architecture:

                controller_manager
                       |
                ZeroErrTwinSystem
                       |
                EthercatDriver
                       |
                  IgH master 0
                       |
                slaves 0 .. 11
        -->
        <ros2_control name="${name}" type="system">

            <!-- ==================================================== -->
            <!-- Hardware                                             -->
            <!-- ==================================================== -->

            <hardware>

                <!--
                    Fake system for RViz / MoveIt / controller testing.
                -->
                <xacro:if value="${use_fake_hardware}">
                    <plugin>mock_components/GenericSystem</plugin>
                </xacro:if>

                <!--
                    Real ZeroErr EtherCAT hardware.

                    There is intentionally only ONE EthercatDriver
                    instance for both arms.
                -->
                <xacro:unless value="${use_fake_hardware}">
                    <plugin>ethercat_driver/EthercatDriver</plugin>

                    <param name="master_id">0</param>
                    <param name="control_frequency">1000</param>
                    <param name="freeze_on_slave_fault">true</param>
                    <param name="timeout">1000000000</param>
                </xacro:unless>

            </hardware>


            <!-- ==================================================== -->
            <!-- ROBOT 1                                              -->
            <!-- EtherCAT slaves 0 .. 5                               -->
            <!-- ==================================================== -->


            <!-- Robot 1 - Joint 1 - Slave 0 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_1"
                module_name="robot1_zero_err1"
                slave_position="0"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot1_Joint_1']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 1 - Joint 2 - Slave 1 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_2"
                module_name="robot1_zero_err2"
                slave_position="1"
                slave_config="$(find zeroerr)/config/zeroErr1.yaml"
                initial_position="${initial_positions['robot1_Joint_2']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 1 - Joint 3 - Slave 2 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_3"
                module_name="robot1_zero_err3"
                slave_position="2"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot1_Joint_3']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 1 - Joint 4 - Slave 3 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_4"
                module_name="robot1_zero_err4"
                slave_position="3"
                slave_config="$(find zeroerr)/config/zeroErr1.yaml"
                initial_position="${initial_positions['robot1_Joint_4']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 1 - Joint 5 - Slave 4 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_5"
                module_name="robot1_zero_err5"
                slave_position="4"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot1_Joint_5']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 1 - Joint 6 - Slave 5 -->
            <xacro:erob_control_joint
                joint_name="robot1_Joint_6"
                module_name="robot1_zero_err6"
                slave_position="5"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot1_Joint_6']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- ==================================================== -->
            <!-- ROBOT 2                                              -->
            <!-- EtherCAT slaves 6 .. 11                              -->
            <!-- ==================================================== -->


            <!-- Robot 2 - Joint 1 - Slave 6 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_1"
                module_name="robot2_zero_err1"
                slave_position="6"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot2_Joint_1']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 2 - Joint 2 - Slave 7 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_2"
                module_name="robot2_zero_err2"
                slave_position="7"
                slave_config="$(find zeroerr)/config/zeroErr1.yaml"
                initial_position="${initial_positions['robot2_Joint_2']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 2 - Joint 3 - Slave 8 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_3"
                module_name="robot2_zero_err3"
                slave_position="8"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot2_Joint_3']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 2 - Joint 4 - Slave 9 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_4"
                module_name="robot2_zero_err4"
                slave_position="9"
                slave_config="$(find zeroerr)/config/zeroErr1.yaml"
                initial_position="${initial_positions['robot2_Joint_4']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 2 - Joint 5 - Slave 10 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_5"
                module_name="robot2_zero_err5"
                slave_position="10"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot2_Joint_5']}"
                use_fake_hardware="${use_fake_hardware}"
            />


            <!-- Robot 2 - Joint 6 - Slave 11 -->
            <xacro:erob_control_joint
                joint_name="robot2_Joint_6"
                module_name="robot2_zero_err6"
                slave_position="11"
                slave_config="$(find zeroerr)/config/zeroErr.yaml"
                initial_position="${initial_positions['robot2_Joint_6']}"
                use_fake_hardware="${use_fake_hardware}"
            />

        </ros2_control>

    </xacro:macro>

</robot>
