<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
      Reusable ZeroErr eRob arm description.

      prefix=""        -> existing single-robot names:
                          Joint_1, Link_1, base_link, ee_link, ...

      prefix="robot1_" -> robot1_Joint_1, robot1_Link_1, ...

      prefix="robot2_" -> robot2_Joint_1, robot2_Link_1, ...

      This macro intentionally contains ONLY the robot.
      Shared environment objects such as table and mounting_surface
      must be defined by the wrapper URDF/Xacro.
  -->
  <xacro:macro name="erob_arm" params="prefix">

    <!-- ============================================================ -->
    <!-- Materials                                                    -->
    <!-- ============================================================ -->

    <material name="${prefix}arm_material">
      <color rgba="0.8000 0.40000 0 1.0000"/>
    </material>

    <material name="${prefix}base_material">
      <color rgba="0.40000 0.40000 0.40000 1.0000"/>
    </material>

    <material name="${prefix}tool_material">
      <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <material name="${prefix}tool_marker">
      <color rgba="1 0 0 1"/>
    </material>


    <!-- ============================================================ -->
    <!-- Robot joints                                                 -->
    <!-- ============================================================ -->

    <joint name="${prefix}Joint_1" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 0.00000 0.00000"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}Link_1"/>
      <axis xyz="0.00000 0.00000 1.00000"/>
      <limit
        effort="20.0"
        lower="-6.28318"
        upper="6.28318"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="10.0"
        soft_lower_limit="-6.28"
        soft_upper_limit="6.28"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>

    <joint name="${prefix}Joint_2" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 0.05300 0.14050"/>
      <parent link="${prefix}Link_1"/>
      <child link="${prefix}Link_2"/>
      <axis xyz="0.00000 -1.00000 0.00000"/>
      <limit
        effort="20.0"
        lower="-3.14159"
        upper="3.14159"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="10.0"
        soft_lower_limit="-3.14"
        soft_upper_limit="3.14"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>

    <joint name="${prefix}Joint_3" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 0.00050 0.36350"/>
      <parent link="${prefix}Link_2"/>
      <child link="${prefix}Link_3"/>
      <axis xyz="0.00000 -1.00000 0.00000"/>
      <limit
        effort="20.0"
        lower="-3.14159"
        upper="3.14159"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="10.0"
        soft_lower_limit="-3.14"
        soft_upper_limit="3.14"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>

    <joint name="${prefix}Joint_4" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 -0.01400 0.31100"/>
      <parent link="${prefix}Link_3"/>
      <child link="${prefix}Link_4"/>
      <axis xyz="0.00000 -1.00000 0.00000"/>
      <limit
        effort="10.5"
        lower="-4.88692"
        upper="3.14159"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="10.0"
        soft_lower_limit="-4.88"
        soft_upper_limit="3.14"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>

    <joint name="${prefix}Joint_5" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 0.04700 0.03900"/>
      <parent link="${prefix}Link_4"/>
      <child link="${prefix}Link_5"/>
      <axis xyz="0.00000 0.00000 1.00000"/>
      <limit
        effort="10.5"
        lower="-3.14159"
        upper="3.14159"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="10.0"
        soft_lower_limit="-3.14"
        soft_upper_limit="3.14"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>

    <joint name="${prefix}Joint_6" type="revolute">
      <origin
        rpy="0.00000 0.00000 0.00000"
        xyz="0.00000 0.06080 0.04700"/>
      <parent link="${prefix}Link_5"/>
      <child link="${prefix}Link_6"/>
      <axis xyz="0.00000 1.00000 0.00000"/>
      <limit
        effort="40.0"
        lower="-12.5664"
        upper="12.5664"
        velocity="1000.0"/>
      <safety_controller
        k_position="100.0"
        k_velocity="100.0"
        soft_lower_limit="-12.56"
        soft_upper_limit="12.56"/>
      <dynamics damping="0.7" friction="0.0"/>
    </joint>


    <!-- ============================================================ -->
    <!-- Link 1                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_1">
      <collision name="Link_1_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_1.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00054"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00052"
          iyz="0.00000"
          izz="0.00054"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00308 0.13617"/>
        <mass value="1.50622"/>
      </inertial>

      <visual name="Link_1_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_1.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Link 2                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_2">
      <collision name="Link_2_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_2_extended.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00157"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00156"
          iyz="0.00000"
          izz="0.00119"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.04217 0.11937"/>
        <mass value="2.16203"/>
      </inertial>

      <visual name="Link_2_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_2_extended.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Link 3                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_3">
      <collision name="Link_3_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_3_extended.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00081"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00091"
          iyz="-0.00001"
          izz="0.00062"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 -0.05451 0.09532"/>
        <mass value="1.77552"/>
      </inertial>

      <visual name="Link_3_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_3_extended.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Link 4                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_4">
      <collision name="Link_4_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_4.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00025"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00024"
          iyz="0.00000"
          izz="0.00026"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00001 0.04110 0.00150"/>
        <mass value="1.31668"/>
      </inertial>

      <visual name="Link_4_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_4.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Link 5                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_5">
      <collision name="Link_5_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_5.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00025"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00026"
          iyz="0.00000"
          izz="0.00024"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="-0.00001 0.00150 0.04110"/>
        <mass value="1.31668"/>
      </inertial>

      <visual name="Link_5_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_5.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Link 6                                                       -->
    <!-- ============================================================ -->

    <link name="${prefix}Link_6">
      <collision name="Link_6_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_6.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00004"
          ixy="0.00000"
          ixz="0.00000"
          iyy="0.00007"
          iyz="0.00000"
          izz="0.00004"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 -0.00578 0.00013"/>
        <mass value="1.10121"/>
      </inertial>

      <visual name="Link_6_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}arm_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/Link_6.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>


    <!-- ============================================================ -->
    <!-- Base                                                         -->
    <!-- ============================================================ -->

    <!-- Empty root link. -->
    <link name="${prefix}base_link"/>

    <!--
        Physical base representation and inertia are kept in a child
        link so the root link itself has no inertial element.
    -->
    <link name="${prefix}base_link_inertial">
      <collision name="base_link_collision">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/base_link.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </collision>

      <inertial>
        <inertia
          ixx="0.00083"
          ixy="0.00001"
          ixz="0.00001"
          iyy="0.00085"
          iyz="0.00003"
          izz="0.00110"/>
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00095 -0.00172 0.03600"/>
        <mass value="1.47602"/>
      </inertial>

      <visual name="base_link_visual">
        <origin
          rpy="0.00000 0.00000 0.00000"
          xyz="0.00000 0.00000 0.00000"/>
        <material name="${prefix}base_material"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/base_link.stl"
            scale="1.00000 1.00000 1.00000"/>
        </geometry>
      </visual>
    </link>

    <joint name="${prefix}base_link_fixed_joint" type="fixed">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}base_link_inertial"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <!-- ============================================================ -->
    <!-- MoveIt-compatible end-effector frame                         -->
    <!-- ============================================================ -->

    <link name="${prefix}ee_link"/>

    <joint name="${prefix}link6_to_ee" type="fixed">
      <parent link="${prefix}Link_6"/>
      <child link="${prefix}ee_link"/>
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    </joint>


    <!-- ============================================================ -->
    <!-- Tool0                                                        -->
    <!-- ============================================================ -->

    <link name="${prefix}tool0">
      <visual>
        <origin
          xyz="0 -0.03 0.042"
          rpy="0 3.14159 3.14159"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/ToolPointer.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${prefix}tool_material"/>
      </visual>

      <collision>
        <origin
          xyz="0 -0.03 0.042"
          rpy="0 3.14159 3.14159"/>
        <geometry>
          <mesh
            filename="package://zeroerr/meshes/paint/ToolPointer.stl"
            scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!--
        Kept intentionally compatible with the existing model.
        With prefix="" both the link and this joint are named "tool0",
        exactly as in the current paint URDF.
    -->
    <joint name="${prefix}tool0" type="fixed">
      <parent link="${prefix}ee_link"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>


    <!-- ============================================================ -->
    <!-- TCP                                                          -->
    <!-- ============================================================ -->

    <link name="${prefix}tcp">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.00050"/>
        </geometry>
        <material name="${prefix}tool_marker"/>
      </visual>
    </link>

    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}tool0"/>
      <child link="${prefix}tcp"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>