<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="eRobo3">

    <!--
        Runtime-selected robot model.

        full_stack.launch.py sets ZEROERR_ROBOT_URDF from runtime.yaml and also passes
        robot_urdf explicitly through MoveItConfigsBuilder.
    -->
    <xacro:arg
        name="robot_urdf"
        default="$(optenv ZEROERR_ROBOT_URDF /__runtime_yaml_must_set_robot_urdf__.urdf)"
    />

    <!--
        Initial joint positions used by ros2_control / GenericSystem.

        Default:
            zeroerr/config/initial_positions.yaml

        A profile can override this through MoveItConfigsBuilder mappings.
    -->
    <xacro:arg
        name="initial_positions_file"
        default="$(find zeroerr)/config/initial_positions.yaml"
    />

    <!--
        ros2_control implementation selected by the active runtime profile.

        Default:
            zeroerr/config/urdfs/eRobo3.ros2_control.xacro

        A profile such as twin_robots can later override this with:
            zeroerr/config/twin_robots/eRobo3.ros2_control.xacro
    -->
    <xacro:arg
        name="ros2_control_xacro"
        default="$(find zeroerr)/config/urdfs/eRobo3.ros2_control.xacro"
    />

    <!--
        false -> real ZeroErr EtherCAT hardware
        true  -> mock_components/GenericSystem
    -->
    <xacro:arg
        name="use_fake_hardware"
        default="false"
    />

    <!-- Import the actual robot URDF selected by runtime.yaml -->
    <xacro:include filename="$(arg robot_urdf)" />

    <!-- Import the ros2_control implementation selected by the active profile -->
    <xacro:include filename="$(arg ros2_control_xacro)" />

    <!--
        Instantiate ros2_control.

        Important:
        Every selectable ros2_control Xacro must expose the same public macro:
            eRobo3_ros2_control

        The normal profile will implement six joints.
        The future twin_robots profile will implement twelve joints.
    -->
    <xacro:eRobo3_ros2_control
        name="ZeroErrSystem"
        initial_positions_file="$(arg initial_positions_file)"
        use_fake_hardware="$(arg use_fake_hardware)"
    />

</robot>